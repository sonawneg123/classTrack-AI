# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=classtrack
DB_PASSWORD=classtrack_password
DB_NAME=classtrack_ai
DB_POOL_LIMIT=10

# ── Auth (legacy — still used by /api/auth/* and as the fallback expiry) ────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Auth (enterprise IAM — /api/v1/auth/*) ──────────────────────────────────
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_TOKEN_BYTES=64

# Account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Email verification — OFF by default
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Forgot / reset password
PASSWORD_RESET_EXPIRES_MINUTES=60

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@classtrack.ai
EMAIL_FROM_NAME=ClassTrack AI

# ── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Model used by the RAG/LLM pipeline (separate from grading):
GROQ_RAG_MODEL=llama3-70b-8192

# ── Embedding Provider ────────────────────────────────────────────────────────
# Provider: 'local' uses @xenova/transformers (no API key needed, runs on-device)
EMBEDDING_PROVIDER=local
# ONNX-compatible model from HuggingFace (via Xenova namespace)
# WARNING: changing this model requires a new Flyway migration to alter
# the vector column dimension in knowledge_chunks.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Must match the embedding model output dimension:
EMBEDDING_DIMENSION=384

# ── RAG Pipeline ──────────────────────────────────────────────────────────────
# Sprint 1: Stage 1 — number of vector candidate chunks to retrieve:
RAG_CANDIDATE_K=20
# Sprint 2: Stage 1b — number of keyword (FTS) candidate chunks to retrieve:
RAG_KEYWORD_CANDIDATE_K=20
# Sprint 1: Stage 2 — max chunks to pass to the LLM as context:
RAG_FINAL_K=8
# Sprint 1: Minimum cosine similarity (0-1) to include a vector chunk:
RAG_MIN_SIMILARITY=0.30
# Sprint 2: Reciprocal Rank Fusion constant k (default 60 per literature):
RAG_RRF_K=60
# Sprint 2 Phase 2: Cross-encoder reranking
# Set to false to disable reranking (hybrid retrieval still works without it):
RAG_RERANKER_ENABLED=true
# Xenova/ONNX cross-encoder model for passage reranking (quantized, ~22MB):
RAG_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Top-N fused candidates to pass into the cross-encoder (keep ≤20 for latency):
RAG_RERANKER_CANDIDATE_K=15
# Maximum extractable characters per document:
RAG_MAX_DOC_CHARS=1000000
# Target tokens per chunk (approx, chars/4):
RAG_CHUNK_TOKENS=512
# Overlap between consecutive chunks in tokens:
RAG_OVERLAP_TOKENS=64
# Upload directory for knowledge documents:
RAG_UPLOAD_DIR=uploads/knowledge
# Maximum knowledge document upload size in MB:
RAG_MAX_SIZE_MB=50
# Maximum retry attempts for a failed document:
RAG_MAX_RETRIES=3

# ── Question Generation ───────────────────────────────────────────────────────
# Maximum questions per single generation request:
QG_MAX_QUESTIONS=20
# Hard character cap for the context body (pre-filter before token budget).
# CALIBRATED: empirically observed ratio is ~1.5-2.4 chars/token for Groq models.
# 3,500 chars / 2.0 c/t = ~1,750 estimated context tokens — well within 8k TPM limit.
# For larger-tier Groq accounts (higher TPM limits) you can increase this safely.
QG_MAX_CONTEXT_CHARS=3500
# Maximum output tokens (absolute ceiling, NOT what is sent per request).
# Per-request output is dynamically set to outputReserve (count-dependent):
QG_MAX_TOKENS=4096
# Generation request timeout in ms:
QG_TIMEOUT_MS=60000
# Prompt version string stored with each generated question:
QG_PROMPT_VERSION=v1
# Retrieval top-K for question generation (may differ from RAG_CANDIDATE_K):
QG_RETRIEVAL_TOP_K=20

# ── LLM Context Budget ────────────────────────────────────────────────────────
# IMPORTANT: QG_LLM_CONTEXT_WINDOW_TOKENS is the EFFECTIVE REQUEST CEILING,
# not the model's architectural context window.  Set it below your Groq TPM limit.
#
# Groq free tier TPM limit:  8,000 tokens
# Recommended effective ceiling: 6,500 tokens (1,500 token safety gap)
#
# The 1,500-token gap absorbs tokenizer approximation error.  Our estimator uses
# 2.0 chars/token but the real Groq tokenizer may count differently.  Setting the
# ceiling at 6,500 means even with 25% underestimation we stay within 8,000.
#
# For larger-tier accounts (higher TPM): raise to 20,000+ as appropriate.
QG_LLM_CONTEXT_WINDOW_TOKENS=6500
# Tokens reserved for the system prompt:
QG_SYSTEM_PROMPT_RESERVE_TOKENS=700
# Tokens reserved for user-prompt scaffolding (headers, delimiters, instructions)
# — does NOT include the context body itself:
QG_USER_PROMPT_OVERHEAD_TOKENS=200
# Tokens reserved per requested question for expected LLM output.
# A single MCQ with 4 options + explanation ~120-180 tokens; 250 is conservative:
QG_OUTPUT_TOKENS_PER_QUESTION=250
# Minimum output reservation even when count=1 (covers JSON scaffolding + wrapper):
QG_MIN_OUTPUT_RESERVE_TOKENS=400
# Safety margin below the effective budget (absorbs residual tokenizer error):
QG_SAFETY_MARGIN_TOKENS=300

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=15
UPLOAD_DIR=uploads
# Profile photo uploads
AVATAR_MAX_SIZE_MB=5
AVATAR_UPLOAD_DIR=uploads/avatars

# ── AI Queue ─────────────────────────────────────────────────────────────────
AI_QUEUE_CONCURRENCY=3

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=debug
LOG_DIR=logs
