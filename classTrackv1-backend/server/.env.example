# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=classtrack
DB_PASSWORD=classtrack_password
DB_NAME=classtrack_ai
DB_POOL_LIMIT=10

# ── Auth (legacy — still used by /api/auth/* and as the fallback expiry) ────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Auth (enterprise IAM — /api/v1/auth/*) ──────────────────────────────────
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_TOKEN_BYTES=64

# Account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Email verification — OFF by default
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Forgot / reset password
PASSWORD_RESET_EXPIRES_MINUTES=60

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@classtrack.ai
EMAIL_FROM_NAME=ClassTrack AI

# ── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Model used by the RAG/LLM pipeline (separate from grading):
GROQ_RAG_MODEL=llama3-70b-8192

# ── Embedding Provider ────────────────────────────────────────────────────────
# Provider: 'local' uses @xenova/transformers (no API key needed, runs on-device)
EMBEDDING_PROVIDER=local
# ONNX-compatible model from HuggingFace (via Xenova namespace)
# WARNING: changing this model requires a new Flyway migration to alter
# the vector column dimension in knowledge_chunks.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Must match the embedding model output dimension:
EMBEDDING_DIMENSION=384

# ── RAG Pipeline ──────────────────────────────────────────────────────────────
# Number of chunks returned per search query:
RAG_TOP_K=20
# Maximum extractable characters per document:
RAG_MAX_DOC_CHARS=1000000
# Target tokens per chunk (approx, chars/4):
RAG_CHUNK_TOKENS=512
# Overlap between consecutive chunks in tokens:
RAG_OVERLAP_TOKENS=64
# Upload directory for knowledge documents:
RAG_UPLOAD_DIR=uploads/knowledge
# Maximum knowledge document upload size in MB:
RAG_MAX_SIZE_MB=50
# Maximum retry attempts for a failed document:
RAG_MAX_RETRIES=3

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=15
UPLOAD_DIR=uploads

# ── AI Queue ─────────────────────────────────────────────────────────────────
AI_QUEUE_CONCURRENCY=3

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=debug
LOG_DIR=logs
